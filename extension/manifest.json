{
  "manifest_version": 3,
  "name": "Personal Vault",
  "version": "0.1.0",
  "description": "Fill and save logins on any site. Works with the Personal Vault desktop app, or on its own with the vault kept in the browser (extension-only mode).",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting",
    "storage",
    "offscreen",
    "alarms",
    "identity"
  ],
  "optional_permissions": [
    "idle"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "detect.js",
        "inline.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "menu.html",
        "prompt.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Personal Vault"
  },
  "commands": {
    "lock-vault": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Lock Personal Vault"
    }
  }
}
