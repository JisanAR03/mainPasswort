{
  "manifest_version": 3,
  "name": "Personal Vault",
  "version": "0.1.0",
  "description": "Fill logins from your Personal Vault desktop app. Stores nothing, and sees one password only when you click to fill.",
  "key": "",
  "permissions": ["nativeMessaging", "activeTab", "scripting", "storage"],
  "optional_host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Personal Vault" }
}
