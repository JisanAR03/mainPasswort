{
  "manifest_version": 3,
  "name": "Personal Vault",
  "version": "0.1.0",
  "description": "Fill and save logins with your Personal Vault desktop app. It handles a password only when you choose to fill or save one.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "detect.js",
        "inline.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "menu.html",
        "prompt.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Personal Vault"
  }
}
