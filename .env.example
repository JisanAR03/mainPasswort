# Copy this file to .env for local development. Never commit .env.
# Placeholder values only: no secrets belong in this file or in .env.
# Load it with: uv run --env-file .env <command>

# Folder the app uses instead of the real per-user data folder.
# Development and test runs must ALWAYS point this at a throwaway folder,
# so no development session can touch a real vault.
PV_DATA_DIR=./.pv-data

# Run Qt without a screen (used by UI tests in CI). Uncomment to use locally.
# QT_QPA_PLATFORM=offscreen
